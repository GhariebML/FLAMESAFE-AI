      "principal_investigator": "Prof. Forman A. Williams (UC San Diego)",
      "target_environments": ["Spacecraft", "Propulsion", "Space Station"],
      "combustion_type": "Isolated Droplet Combustion / Cool Flame"
    },
    "experimental_runs": [
      {
