# ==============================================================================
# FlameSafe AI - Environment Configuration Template (.env.example)
# Copy this file to .env and customize values for your local environment.
# NEVER commit the active .env file to source control.
# ==============================================================================

# --- System & Deployment Environment ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=FlameSafe AI
APP_VERSION=0.1.0

# --- Backend Server Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Configuration ---
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="FlameSafe AI"

# --- Database Configuration (PostgreSQL + pgvector) ---
# For local Docker Compose:
POSTGRES_USER=flamesafe
POSTGRES_PASSWORD=flamesafe_dev_secret
POSTGRES_DB=flamesafe_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://flamesafe:flamesafe_dev_secret@localhost:5432/flamesafe_db

# Fallback SQLite Database (useful for standalone backend tests without Docker)
SQLITE_DATABASE_URL=sqlite+aiosqlite:///./flamesafe_dev.db
USE_SQLITE_FALLBACK=true

# --- AI & LLM Provider Configuration (Configurable Abstraction) ---
# Supported providers: gemini | openai | anthropic | mock
AI_PROVIDER=mock
AI_MODEL_NAME=gemini-1.5-pro
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Embedding & Vector Search Configuration ---
# Supported embedding models: text-embedding-004 | text-embedding-3-small | mock
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME=text-embedding-004
EMBEDDING_DIMENSION=768
VECTOR_TOP_K=5
SIMILARITY_THRESHOLD=0.65

# --- Scientific Data Ingestion & NASA PSI Sources ---
NASA_PSI_BASE_URL=https://psi.nasa.gov/physci/repo
NASA_NTRS_BASE_URL=https://ntrs.nasa.gov/api/citations
INGESTION_DATA_DIR=./data
SEED_DATA_DIR=./data/seed
PROCESSED_DATA_DIR=./data/processed
MAX_INGESTION_WORKERS=4
